Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Deja libre el reto ACME de Plesk/Let's Encrypt para renovar HTTPS.
RewriteRule ^\.well-known/acme-challenge/ - [L]

# Nunca servir código, configuración, librerías, SQL, tests o documentación.
RewriteRule ^(?:includes|lib|sql|tests|docs)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
</IfModule>

<FilesMatch "\.(?:sql|log|ini|env|bak|md|json|lock|example)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    <FilesMatch "\.(?:css|js|png|webp)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
