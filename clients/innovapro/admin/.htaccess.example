# Solo como alternativa si no utilizas el gestor de directorios protegidos de Plesk.
# Sustituye la ruta por la ruta absoluta real y renombra este archivo a .htaccess.
AuthType Basic
AuthName "InnovaPro Leads"
AuthUserFile /ruta/privada/fuera-del-webroot/.htpasswd
Require valid-user
Options -Indexes
